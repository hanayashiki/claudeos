{
  // rust-analyzer loads the whole workspace in the Cargo.toml at the root, so
  // hover and go to definition work in every crate from one window.
  //
  // It applies one target to every crate: cargo has no stable way to give a
  // package its own target, so rust-analyzer cannot analyse the kernel for
  // aarch64-unknown-none-softfloat and cbox for aarch64-unknown-linux-musl at
  // once. With aarch64-unknown-linux-musl every crate resolves: cbox and inet
  // are analysed for the target they are built for; the kernel and cbox with
  // their aarch64 code active, the board's code and the larger half of the
  // kernel; and fatdisk and distro against a std that compiles them. A
  // bare-metal target leaves cbox, inet and distro without std (48, 13 and 16
  // unresolved names). x86_64-unknown-linux-musl analyses the x86-64 half
  // instead, also without errors. Leaving the target unset gives the host's,
  // which on an Apple silicon Mac analyses the same as this and on an x86-64
  // machine does not.
  //
  // Measured with rust-analyzer 0.3.3049's `analysis-stats .` and
  // `diagnostics .` at the root: with this target 12 crates, 158 modules, 34
  // expressions of unknown type and no errors. Before the workspace, the root
  // found only kernel/, 71 modules, and fatdisk on its own had 202 errors, from
  // the kernel's FAT code it could not reach.
  "rust-analyzer.cargo.target": "aarch64-unknown-linux-musl",

  // The check on save runs `cargo check --workspace --all-targets`. The kernel
  // links no std and has no unwinder, so under the dev profile's unwinding
  // panics it fails to check; kernel-dev is the dev profile with panic =
  // "abort". The other crates check the same under either.
  "rust-analyzer.check.extraArgs": ["--profile", "kernel-dev"]
}
